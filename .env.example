# Sanity Project Settings
# Get these from https://sanity.io/manage after creating your project

# Your Sanity Project ID (found in sanity.io/manage)
SANITY_PROJECT_ID=your_project_id_here

# Your dataset name (usually "production")
SANITY_DATASET=production

# API version (use today's date or leave as is)
SANITY_API_VERSION=2024-01-01

# For Sanity Studio (used by sanity.config.ts)
SANITY_STUDIO_PROJECT_ID=your_project_id_here
SANITY_STUDIO_DATASET=production
